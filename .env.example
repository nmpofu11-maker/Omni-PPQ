# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional VAPID keys for persistent Web Push notifications across restarts
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:alerts@omnipulse.local"

# Required in production to use /api/adaptive/learn|promote|rollback and /api/push/test.
# Send as "Authorization: Bearer <token>". Without it, production keeps these endpoints closed (503);
# in development only direct loopback connections are admitted.
ADMIN_TOKEN=""

# Number of reverse proxies in front of the app (e.g. 1 on Cloud Run/Nginx). Leave unset when
# exposed directly, otherwise X-Forwarded-For could be spoofed to evade rate limits.
TRUST_PROXY=""

# Learner promotion is never automatic; set to "true" only after reviewing a candidate.
ADAPTIVE_PROMOTION_ENABLED="false"

# Optional: weight on the model (0-1) when blending with the de-vigged market price. 1 disables shrinkage.
# Unset = tier defaults (0.8 play-by-play, 0.7 live box score, 0.5 record prior).
MODEL_MARKET_WEIGHT=""
